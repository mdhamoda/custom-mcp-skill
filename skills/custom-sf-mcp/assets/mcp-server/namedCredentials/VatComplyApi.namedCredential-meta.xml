<?xml version="1.0" encoding="UTF-8"?>
<!--
  Worked example: a Legacy-type NamedCredential for a genuine, public, no-auth external API
  (vatcomply.com), paired with the Custom-type ExternalServiceRegistration in the sibling
  externalServiceRegistrations/ folder. See references/external-service-registration.md §6.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>VatComplyApi</label>
    <namedCredentialType>Legacy</namedCredentialType>
    <endpoint>https://api.vatcomply.com</endpoint>
    <principalType>Anonymous</principalType>
    <protocol>NoAuthentication</protocol>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
</NamedCredential>
