<?xml version="1.0" encoding="UTF-8"?>
<!--
  HARDENED OAuth policy - deploy this for anything beyond a scratch/demo org.
  Place in:  extlClntAppOauthPolicies/<NAME>_defaultPolicy.ecaOauthPlcy-meta.xml
  (suffix is .ecaOauthPlcy, abbreviated)

  A policy record is AUTO-CREATED on first deploy with permissive defaults [org verified]:
      permittedUsersPolicyType   AllSelfAuthorized   -> ANY org user may self-authorize
      refreshTokenValidityPeriod 365 Days            -> vs Salesforce guidance of <= 30

  This file overrides both. Deploy alongside the three required ECA files.

  Leave the three flow toggles false - hosted MCP is authorization-code only.
  Raise requiredSessionLevel to force MFA-backed sessions where your policy requires it.
-->
<ExtlClntAppOauthConfigurablePolicies xmlns="http://soap.sforce.com/2006/04/metadata">
    <externalClientApplication>McpClientApp</externalClientApplication>
    <ipRelaxationPolicyType>Enforce</ipRelaxationPolicyType>
    <isClientCredentialsFlowEnabled>false</isClientCredentialsFlowEnabled>
    <isGuestCodeCredFlowEnabled>false</isGuestCodeCredFlowEnabled>
    <isTokenExchangeFlowEnabled>false</isTokenExchangeFlowEnabled>
    <label>McpClientApp_defaultPolicy</label>
    <permittedUsersPolicyType>AdminApproved</permittedUsersPolicyType>
    <refreshTokenPolicyType>SpecificLifetime</refreshTokenPolicyType>
    <refreshTokenValidityPeriod>30</refreshTokenValidityPeriod>
    <refreshTokenValidityUnit>Days</refreshTokenValidityUnit>
    <requiredSessionLevel>STANDARD</requiredSessionLevel>
</ExtlClntAppOauthConfigurablePolicies>
