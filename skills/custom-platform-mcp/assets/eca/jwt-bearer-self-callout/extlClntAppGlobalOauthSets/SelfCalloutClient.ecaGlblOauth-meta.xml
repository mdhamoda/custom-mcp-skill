<?xml version="1.0" encoding="UTF-8"?>
<ExtlClntAppGlobalOauthSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <callbackUrl>https://localhost/oauth/callback</callbackUrl>
    <!--
      CRITICAL: this must be the certificate Salesforce ACTUALLY RETRIEVES for the Certificate
      developer name below -- NOT the .crt content you originally uploaded when creating the
      Certificate metadata record. Salesforce auto-generates its own internal signing cert for a
      Certificate component and signs with THAT, silently, regardless of what public cert was
      uploaded. Get the real one with:
        sf project retrieve start --metadata "Certificate:<DeveloperName>" -o <alias>
      then paste the retrieved .crt's PEM body here. Skipping this step produces
      `invalid_client: invalid client credentials` that looks like a wrong-consumer-key problem
      but isn't -- see references/eca-and-testing.md §5.4.
    -->
    <certificate>{{RETRIEVED_CERTIFICATE_PEM_BODY}}</certificate>
    <consumerKey>{{GENERATED_ON_DEPLOY_THEN_RETRIEVE}}</consumerKey>
    <externalClientApplication>SelfCalloutClient</externalClientApplication>
    <isClientCredentialsFlowEnabled>false</isClientCredentialsFlowEnabled>
    <isCodeCredFlowEnabled>false</isCodeCredFlowEnabled>
    <isCodeCredPostOnly>false</isCodeCredPostOnly>
    <isConsumerSecretOptional>true</isConsumerSecretOptional>
    <isDPopEnabled>false</isDPopEnabled>
    <isDeviceFlowEnabled>false</isDeviceFlowEnabled>
    <isEnforceRefreshTokenTTL>true</isEnforceRefreshTokenTTL>
    <!--
      [org] true issues a real, decodable JWT access token (token_format:"jwt", RS256, real
      sub/iss/aud/client_id claims) instead of an opaque string -- confirmed by manually
      reconstructing the raw token request and decoding what came back. See
      references/eca-and-testing.md §5.7.
    -->
    <isNamedUserJwtEnabled>true</isNamedUserJwtEnabled>
    <!--
      [org] Inert for JWT Bearer regardless of value -- this grant type never touches
      /oauth2/authorize, so PKCE's rules have no code path to apply to. Also: this org appears to
      enforce isPkceRequired:true as a platform baseline -- a deploy setting it false succeeds but
      silently reverts to true shortly after, confirmed twice including through a full
      disable-app/redeploy/re-enable cycle. Don't spend time fighting it; it doesn't block
      anything here. See references/eca-and-testing.md §5.7 and §1.2.
    -->
    <isPkceRequired>true</isPkceRequired>
    <isRefreshTokenRotationEnabled>true</isRefreshTokenRotationEnabled>
    <isSecretRequiredForRefreshToken>false</isSecretRequiredForRefreshToken>
    <isSecretRequiredForTokenExchange>false</isSecretRequiredForTokenExchange>
    <isTokenExchangeEnabled>false</isTokenExchangeEnabled>
    <label>Self Callout Client OAuth</label>
    <shouldRotateConsumerKey>false</shouldRotateConsumerKey>
    <shouldRotateConsumerSecret>false</shouldRotateConsumerSecret>
</ExtlClntAppGlobalOauthSettings>
