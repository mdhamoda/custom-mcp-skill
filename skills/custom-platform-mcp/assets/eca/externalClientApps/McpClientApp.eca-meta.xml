<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Client App - header file.  Deploy WITH the two OAuth siblings; they fail alone.
  Filename = API name; every sibling's <externalClientApplication> must match it exactly.
  distributionState: Local (this org) | Packageable (2GP distribution)
-->
<ExternalClientApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>admin@example.com</contactEmail>
    <description>Lets an MCP client connect to this org's Salesforce Hosted MCP Servers.</description>
    <distributionState>Local</distributionState>
    <isProtected>false</isProtected>
    <label>MCP Client App</label>
</ExternalClientApplication>
