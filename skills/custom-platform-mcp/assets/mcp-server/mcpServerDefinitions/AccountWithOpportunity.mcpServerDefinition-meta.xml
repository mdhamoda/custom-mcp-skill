<?xml version="1.0" encoding="UTF-8"?>
<!--
  EXAMPLE ARTIFACT - custom MCP server carrying three identifier forms in one definition.
  Ships with the custom-platform-mcp skill. Org-verified at API v67.0.

  Demonstrates the "buffet and plate" model: a custom server may serve YOUR tools and
  RE-SERVE a standard server's tool side by side.

    aa:apex-<ClassName>     your Apex  global @InvocableMethod
    fa:flow-<FlowName>      your Autolaunched Flow
    psmcps:<ns>.<srv>:<op>  a Platform Standard MCP tool, re-served here

  All three use apiSource API_CATALOG.

  IDENTIFIER RULE
    KNOWN form (aa: / fa:)  -> hand-write it, copying the shape below.
    UNKNOWN form (a backing type not in the spec table, e.g. @AuraEnabled, Apex REST,
                  an Agentforce agent) -> add it once in Setup, retrieve the definition,
                  copy the generated value, then record the new row in the spec table.

  DEPLOY BEHAVIOUR
    A same-named deploy OVERWRITES. <tools> is replaced wholesale - deploying a two-tool
    file over a three-tool server silently drops one. Retrieve before you edit.

  ACTIVATION
    Deploying does NOT activate. Create the access row pointing at this definition:
      POST /services/data/v<VER>/tooling/sobjects/McpServerAccess
      {"DeveloperName":"<Name>","MasterLabel":"<Name>","Active":true,"McpServerId":"<defId>"}
    McpServerId is REQUIRED for custom servers (it is null for standard ones).
-->
<McpServerDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Account operations for agents: create accounts with an optional opportunity, and reach metadata operations.</description>
    <masterLabel>Account With Opportunity</masterLabel>

    <!-- ============ aa: your Apex global @InvocableMethod ============
         operation = the CLASS name, not the method name.
         Verify first:  GET /services/data/v<VER>/actions/custom/apex          -->
    <tools>
        <apiDefinition>
            <apiIdentifier>aa:apex-AccountWithOpportunityService</apiIdentifier>
            <apiSource>API_CATALOG</apiSource>
            <operation>AccountWithOpportunityService</operation>
        </apiDefinition>
        <descriptionOverride>Creates a Salesforce account and, when requested, a related opportunity in the same transaction. Use when a user asks to add a new account or customer, optionally with a first deal. If the opportunity cannot be created the account is rolled back, so no partial records remain. Returns the new account id, the opportunity id when one was created, and a summary.</descriptionOverride>
        <destructive>false</destructive>
        <idempotent>false</idempotent>
        <openWorld>false</openWorld>
        <readOnly>false</readOnly>
        <returnDirect>false</returnDirect>
        <toolName>createAccountWithOpportunity</toolName>
        <toolTitle>Create Account With Optional Opportunity</toolTitle>
    </tools>

    <!-- ============ fa: your Autolaunched Flow ============
         Flow must be AutoLaunchedFlow, Active, with defined input/output variables.
         operation = the FLOW API name.
         Verify first:  GET /services/data/v<VER>/actions/custom/flow           -->
    <tools>
        <apiDefinition>
            <apiIdentifier>fa:flow-Create_Account_With_Opportunity</apiIdentifier>
            <apiSource>API_CATALOG</apiSource>
            <operation>Create_Account_With_Opportunity</operation>
        </apiDefinition>
        <descriptionOverride>Declarative variant of account creation. Creates a Salesforce account and, when requested, a related opportunity. Same outcome as the Apex tool but maintained in Flow Builder, so an administrator can change the behaviour without a code deployment.</descriptionOverride>
        <destructive>false</destructive>
        <idempotent>false</idempotent>
        <openWorld>false</openWorld>
        <readOnly>false</readOnly>
        <returnDirect>false</returnDirect>
        <toolName>createAccountWithOpportunityViaFlow</toolName>
        <toolTitle>Create Account With Optional Opportunity (Flow)</toolTitle>
    </tools>

    <!-- ============ psmcps: a Platform Standard MCP tool, re-served ============
         Format:  psmcps:<namespace>.<server>:<operation>
         Lets one curated server expose a standard capability beside your own tools,
         so a client needs ONE connector instead of two.
         The standard server must be activated in its own right.                -->
    <tools>
        <apiDefinition>
            <apiIdentifier>psmcps:platform.metadata-experts:executeMetadataAction</apiIdentifier>
            <apiSource>API_CATALOG</apiSource>
            <operation>executeMetadataAction</operation>
        </apiDefinition>
        <descriptionOverride>Executes an invocable metadata action. Supports UI-building metadata types such as FlexiPage, CustomObject, CustomTab and CustomApplication. Requires metadataType, actionName and an optional parameters object.</descriptionOverride>
        <destructive>false</destructive>
        <idempotent>false</idempotent>
        <openWorld>false</openWorld>
        <readOnly>false</readOnly>
        <returnDirect>false</returnDirect>
        <toolName>executeMetadataAction</toolName>
        <toolTitle>Execute Metadata Action</toolTitle>
    </tools>

    <!-- ============ prompts: a different primitive, not a tool ============
         User-initiated (slash command / picker), no annotations, Flex + published only.
         A prompt can ALSO be exposed as an agent-callable TOOL via a pr: identifier
         under <tools> - choose by who should trigger it.
    <prompts>
        <descriptionOverride>What the user sees when choosing this prompt.</descriptionOverride>
        <promptName>Namespace__templateApiName</promptName>
        <promptTemplateName>Namespace__templateApiName</promptTemplateName>
        <promptTitle>Human Readable Title</promptTitle>
    </prompts>
    -->
</McpServerDefinition>
